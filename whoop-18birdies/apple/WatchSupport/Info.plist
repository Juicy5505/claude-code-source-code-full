<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>WHOOP Golf</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSHealthShareUsageDescription</key>
	<string>WHOOP Golf reads heart rate during a golf workout.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>WHOOP Golf saves your round as a golf workout and attaches its route.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>WHOOP Golf uses GPS during a round to measure shot-to-shot distance and save the route.</string>
	<key>NSMotionUsageDescription</key>
	<string>WHOOP Golf uses wrist motion to detect golf swings and tempo.</string>
	<!-- location, and ONLY location. The audio/remote-notification entries that
	     used to sit here were plausibly what blocked the companion install, and
	     they stay gone. But location is required on watchOS: Core Location's
	     backgroundable check reads UIBackgroundModes even on the watch (Apple's
	     watchOS 4 release notes, 29483437), and LocationManager.swift sets
	     allowsBackgroundLocationUpdates = true — without this key that line
	     throws NSInternalInconsistencyException and kills the app the moment a
	     round starts. Verified against a built bundle by watch/build.sh on the
	     Kit A project, which carries the same pair of keys. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>WKApplication</key>
	<true/>
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.alex.whoopgolf</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay "driving task" category — Apple must grant this for on-device use.
	     Request it at https://developer.apple.com/contact/carplay/
	     The Xcode CarPlay Simulator works without the grant. -->
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
</dict>
</plist>

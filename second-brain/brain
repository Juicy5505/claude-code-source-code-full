def cmd_init(args) -> int:
    root = project_root()
    name = args.name or root.name
    vault = Path(os.path.expanduser(args.vault)) if args.vault else DEFAULT_VAULT_ROOT / name
    vault.mkdir(parents=True, exist_ok=True)

    for folder in FOLDERS:
        (vault / folder).mkdir(exist_ok=True)
        keep = vault / folder / ".gitkeep"
        if not any(p for p in (vault / folder).iterdir() if p.name != ".gitkeep"):
            keep.touch()

    # An .obsidian directory is what makes the folder open as a vault rather
    # than prompting to create one.
    obsidian = vault / ".obsidian"
    obsidian.mkdir(exist_ok=True)
    if not (obsidian / "app.json").exists():
        write_json(obsidian / "app.json", {"alwaysUpdateLinks": True, "newLinkFormat": "relative"})

    seeds = {
        vault / "MOC.md": MOC_TEMPLATE.format(name=name),
        vault / "CLAUDE.md": VAULT_CLAUDE_MD.format(root=root),
        vault / "99-Meta" / "Toolchain.md": TOOLCHAIN_MD,
        vault / "99-Meta" / "Open Threads.md": OPEN_THREADS_MD,
    }
    created = []
    for path, body in seeds.items():
        if not path.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(body, encoding="utf-8")
            created.append(path.name)

    write_json(root / MARKER, {"vault": str(vault), "name": name, "boundAt": iso()})
    register(root, vault, name)
    ensure_session_note(vault, name)

    print(f"vault:   {vault}")
    print(f"project: {root}")
    if created:
        print(f"created: {', '.join(created)}")
    print(f"marker:  {root / MARKER}  (commit this so a clone finds the same vault)")
    return 0


def cmd_where(args) -> int:
    vault = find_vault()
    if vault is None:
        print("no vault bound; run `brain init`", file=sys.stderr)
        return 1
    print(vault)
    return 0


def cmd_list(args) -> int:
    vaults = registry()["vaults"]
    if not vaults:
        print("no vaults yet; run `brain init` in a project")
        return 0
    width = max(len(v["name"]) for v in vaults.values())
    for root, entry in sorted(vaults.items(), key=lambda kv: kv[1]["name"].lower()):
        exists = "" if Path(entry["vault"]).exists() else "  (MISSING)"
        print(f"{entry['name']:<{width}}  {entry['vault']}{exists}")
        print(f"{'':<{width}}  ↳ {root}")
    return 0


def _vault_and_name() -> tuple[Path, str]:
    vault = require_vault()
    root = project_root()
    entry = registry()["vaults"].get(str(root), {})
    return vault, entry.get("name", vault.name)


def hook_safe(fn):
    """A hook must never fail the session it is attached to.

    Claude Code surfaces a non-zero hook exit to the user, and a raw traceback
    on stderr lands in their terminal mid-task. Every failure mode here — no
    vault bound, vault deleted, disk full — is one where the right behaviour is
    to record nothing and get out of the way.
    """

    def wrapped(args) -> int:
        try:
            return fn(args)
        except SystemExit:
            return 0  # require_vault's "no vault here" is normal, not an error
        except Exception:  # noqa: BLE001 - deliberately total
            return 0

    wrapped.__name__ = fn.__name__
    wrapped.__doc__ = fn.__doc__
    return wrapped


@hook_safe
def cmd_prompt(args) -> int:
    """Record a prompt verbatim. Wired to the UserPromptSubmit hook."""
    text = args.text or sys.stdin.read()
    # Hook payloads arrive as JSON on stdin; a bare string is also accepted so
    # the command stays usable by hand.
    text = text.strip()
    if text.startswith("{"):
        try:
            text = str(json.loads(text).get("prompt", "")).strip()
        except json.JSONDecodeError:
            pass
    if not text:
        return 0
    vault, name = _vault_and_name()
    path = ensure_session_note(vault, name)
    quoted = "\n".join(f"> {line}" if line.strip() else ">" for line in text.splitlines())
    add_to_section(path, "Prompts", f"\n**{stamp()}**\n\n{quoted}\n")
    return 0


def cmd_log(args) -> int:
    vault, name = _vault_and_name()
    path = ensure_session_note(vault, name)
    text = args.text or sys.stdin.read().strip()
    if not text:
        return 0
    kind = f"`{args.kind}` " if args.kind else ""
    add_to_section(path, "Actions", f"- **{stamp()}** {kind}{text}")
    return 0



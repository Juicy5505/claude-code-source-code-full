#!/usr/bin/env python3
"""brain — Obsidian as Claude Code's persistent memory.

The idea in one line: a Claude Code session is amnesiac, an Obsidian vault is
not, so every session reads the vault on the way in and writes to it on the way
out. Standing instructions alone do not achieve that — they get crowded out of a
long context. Hooks do, because the harness fires them whether or not the model
remembers to. That is why this is a program and not a paragraph.

Dependency-free Python 3, matching the rest of this repo. Every command is safe
to run repeatedly; nothing here ever deletes a note.

    brain init [--vault PATH] [--name NAME]   create/attach a vault for this project
    brain where                               print the vault bound to this directory
    brain session-start                        emit the vault's active context (hook)
    brain prompt [TEXT]                        record a prompt verbatim (hook)
    brain tool                                 record a file change (hook)
    brain log TEXT [--kind KIND]               append an entry to today's session note
    brain decision TITLE [--why ...]           record a decision as its own note
    brain note TITLE [--folder F] [--tag T]    create a durable knowledge note
    brain session-end                          close out today's note (hook)
    brain graph [--query Q] [--code-only]      build/query the code graph (Graphify)
    brain index                                rebuild the map-of-content
    brain search QUERY                         grep the vault, newest first
    brain recall [QUERY]                       what a new session should know
    brain doctor                               check the whole toolchain
    brain list                                 every vault this machine knows
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

IS_WINDOWS = os.name == "nt"
IS_MACOS = sys.platform == "darwin"

HOME = Path.home()
REGISTRY = HOME / ".brain" / "vaults.json"
MARKER = ".brain.json"
DEFAULT_VAULT_ROOT = Path(os.environ.get("BRAIN_VAULT_ROOT", HOME / "Obsidian"))

# Folder numbering keeps the vault sorted the way the work actually flows:
# raw capture first, distilled knowledge after, machinery last.
FOLDERS = [
    "00-Inbox",
    "01-Sessions",
    "02-Decisions",
    "03-Knowledge",
    "04-Code",
    "05-Graph",
    "06-Integrations",
    "99-Meta",
]

SESSION_SECTIONS = ["Prompts", "Actions", "Decisions", "Open threads"]


# ---------------------------------------------------------------- utilities


def now() -> datetime:
    return datetime.now().astimezone()


def today() -> str:
    return now().strftime("%Y-%m-%d")


def stamp() -> str:
    return now().strftime("%H:%M")


def iso() -> str:
    return now().replace(microsecond=0).isoformat()


def slugify(text: str, limit: int = 60) -> str:
    """Filesystem- and wikilink-safe. Obsidian chokes on # ^ [ ] | in names."""
    cleaned = re.sub(r"[#\^\[\]\|:/\\<>\"\*\?]", " ", text)
    cleaned = re.sub(r"\s+", " ", cleaned).strip()
    return (cleaned[:limit].strip() or "untitled")


def read_json(path: Path, fallback):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return fallback
    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
        # Loud, not silent: a corrupt registry that we quietly replace would
        # orphan every vault on the machine.
        raise SystemExit(f"brain: {path} is not valid JSON ({exc}). Fix or remove it.")


def write_json(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


class vault_lock:
    """Serialise read-modify-write on the vault across processes.

    Claude Code fires hooks concurrently — a PostToolUse for a file edit can
    land while a UserPromptSubmit is still rewriting today's note. Both read the
    whole file, modify it, and write it back, so without a lock the later write
    silently discards the earlier one and an entry vanishes from the record.

    An advisory flock on a sibling file. Best-effort: if locking is unavailable
    the work still happens, because losing an entry is better than a hook that
    fails and disrupts the session.
    """

    def __init__(self, target: Path):
        self.path = target.parent / f".{target.name}.lock"
        self.handle = None

    def __enter__(self):
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            self.handle = self.path.open("w")
            if IS_WINDOWS:
                # Windows has no flock. msvcrt.locking is the equivalent, and it
                # blocks rather than failing, which is what we want here.
                import msvcrt

                self.handle.write(" ")
                self.handle.flush()
                self.handle.seek(0)
                msvcrt.locking(self.handle.fileno(), msvcrt.LK_LOCK, 1)
            else:
                import fcntl

                fcntl.flock(self.handle, fcntl.LOCK_EX)
        except (ImportError, OSError):
            # Best-effort: losing an entry is better than a hook that fails.
            if self.handle is not None:
                self.handle.close()
            self.handle = None
        return self

    def __exit__(self, *exc):
        if self.handle is not None:
            try:
                if IS_WINDOWS:
                    import msvcrt

                    self.handle.seek(0)
                    msvcrt.locking(self.handle.fileno(), msvcrt.LK_UNLCK, 1)
                else:
                    import fcntl

                    fcntl.flock(self.handle, fcntl.LOCK_UN)
            except (ImportError, OSError):
                pass
            self.handle.close()
            self.handle = None
        return False


def append(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(text)


def git_root(start: Path) -> Path | None:
    for candidate in [start, *start.parents]:
        if (candidate / ".git").exists():
            return candidate
    return None


def project_root(start: Path | None = None) -> Path:
    """The project this vault belongs to: the git root, else the cwd."""
    start = (start or Path.cwd()).resolve()
    for candidate in [start, *start.parents]:
        if (candidate / MARKER).exists():
            return candidate
    return git_root(start) or start


# ------------------------------------------------------------ vault binding


def registry() -> dict:
    data = read_json(REGISTRY, {"vaults": {}})
    data.setdefault("vaults", {})
    return data


def register(root: Path, vault: Path, name: str) -> None:
    data = registry()
    data["vaults"][str(root)] = {"vault": str(vault), "name": name, "boundAt": iso()}
    write_json(REGISTRY, data)


def find_vault(start: Path | None = None) -> Path | None:
    """Resolve the vault for a directory: marker file first, registry second.

    The marker travels with the repo (so a clone on another machine can find
    its own vault), the registry is the machine's index (so `brain list` can
    answer without walking the disk). Marker wins when they disagree.
    """
    root = project_root(start)
    marker = root / MARKER
    if marker.exists():
        bound = read_json(marker, {}).get("vault")
        if bound:
            return Path(os.path.expanduser(bound))
    entry = registry()["vaults"].get(str(root))
    if entry:
        return Path(entry["vault"])
    return None


def require_vault() -> Path:
    vault = find_vault()
    if vault is None:
        raise SystemExit(
            "brain: no vault bound to this project.\n"
            "  Run:  brain init\n"
            "  This creates one under ~/Obsidian/ and binds it here."
        )
    if not vault.exists():
        raise SystemExit(
            f"brain: vault {vault} is registered but missing.\n"
            "  It was moved or deleted. Re-run `brain init --vault <new path>`."
        )
    return vault


# ------------------------------------------------------------- vault layout


def session_note(vault: Path, day: str | None = None) -> Path:
    return vault / "01-Sessions" / f"{day or today()}.md"


def ensure_session_note(vault: Path, name: str) -> Path:
    path = session_note(vault)
    if path.exists():
        return path
    body = [
        "---",
        f"date: {today()}",
        f"project: {name}",
        "type: session",
        "tags: [session, claude-code]",
        "---",
        "",
        f"# {today()} — {name}",
        "",
        "> Written by Claude Code. This is the raw capture layer: what was asked,",
        "> what was done, what was decided. Distilled notes link back here.",
        "",
    ]
    for section in SESSION_SECTIONS:
        body += [f"## {section}", ""]
    append(path, "\n".join(body))
    return path


def add_to_section(path: Path, section: str, entry: str) -> None:
    """Insert under an existing '## Section', appending the section if absent.

    Reading and rewriting the file (rather than appending blindly) is what keeps
    a day's prompts together instead of interleaved with actions in arrival
    order, which is unreadable a week later.
    """
    with vault_lock(path):
        _add_to_section_locked(path, section, entry)


def _add_to_section_locked(path: Path, section: str, entry: str) -> None:
    text = path.read_text(encoding="utf-8") if path.exists() else ""
    heading = f"## {section}"
    if heading not in text:
        append(path, f"\n{heading}\n\n{entry}\n")
        return
    lines = text.splitlines()
    start = next(i for i, line in enumerate(lines) if line.strip() == heading)
    end = len(lines)
    for i in range(start + 1, len(lines)):
        if lines[i].startswith("## "):
            end = i
            break
    while end > start + 1 and not lines[end - 1].strip():
        end -= 1
    lines[end:end] = [entry]
    tmp = path.with_suffix(".md.tmp")
    tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
    os.replace(tmp, path)



def cmd_note(args) -> int:
    vault, name = _vault_and_name()
    folder = args.folder if args.folder in FOLDERS else "03-Knowledge"
    title = slugify(args.title)
    path = vault / folder / f"{title}.md"
    tags = ["knowledge"] + list(args.tag or [])
    if path.exists():
        append(path, f"\n\n---\n\n**Revised {today()}**\n\n{args.body or ''}\n")
        print(path)
        return 0
    body = [
        "---",
        f"created: {today()}",
        f"project: {name}",
        "type: knowledge",
        f"tags: [{', '.join(sorted(set(tags)))}]",
        "---",
        "",
        f"# {args.title}",
        "",
        args.body or "_(what is true, and how it was verified)_",
        "",
        "---",
        f"First recorded: [[01-Sessions/{today()}|{today()}]]",
        "",
    ]
    path.write_text("\n".join(body), encoding="utf-8")
    add_to_section(
        ensure_session_note(vault, name),
        "Actions",
        f"- **{stamp()}** note → [[{folder}/{title}|{args.title}]]",
    )
    print(path)
    return 0


@hook_safe
def cmd_tool(args) -> int:
    """Record a file-changing tool call. Wired to the PostToolUse hook.

    Only file mutations are captured, deliberately. Logging every read and grep
    would bury the signal — what a future session needs is *which files this
    work touched*, which is exactly the set of edits and writes.
    """
    try:
        raw = args.text or sys.stdin.read()
        payload = json.loads(raw) if raw.strip().startswith("{") else {}
        tool = payload.get("tool_name", "")
        target = (payload.get("tool_input") or {}).get("file_path", "")
        if not tool or not target:
            return 0
        vault, name = _vault_and_name()
        path = ensure_session_note(vault, name)
        rel = os.path.relpath(target, project_root()) if os.path.isabs(target) else target
        # One line per file per day — but check ONLY the Actions section.
        # Scanning the whole note meant a prompt that merely mentioned a path in
        # backticks poisoned the check, and every real edit to that file was
        # then silently never recorded.
        text = path.read_text(encoding="utf-8")
        actions = text.split("## Actions", 1)[-1].split("\n## ", 1)[0]
        if f"`{rel}`" in actions:
            return 0
        add_to_section(path, "Actions", f"- **{stamp()}** {tool.lower()} → `{rel}`")
    except Exception:  # noqa: BLE001 - a hook must never break a tool call
        pass
    return 0


@hook_safe
def cmd_session_end(args) -> int:
    vault, name = _vault_and_name()
    path = session_note(vault)
    if not path.exists():
        return 0
    text = args.text
    if not text:
        raw = "" if sys.stdin.isatty() else sys.stdin.read()
        reason = ""
        if raw.strip().startswith("{"):
            try:
                reason = str(json.loads(raw).get("reason", ""))
            except json.JSONDecodeError:
                pass
        text = f"session ended ({reason})" if reason else "session ended"

    # A session where nothing was asked leaves no thread worth carrying
    # forward; appending one anyway turns Open Threads into a heartbeat log.
    body = path.read_text(encoding="utf-8")
    section = body.split("## Prompts", 1)[-1].split("## ", 1)[0]
    if not section.strip():
        return 0

    add_to_section(path, "Open threads", f"- **{stamp()}** {text}")
    threads = vault / "99-Meta" / "Open Threads.md"
    if not threads.exists():
        threads.write_text(OPEN_THREADS_MD, encoding="utf-8")
    append(threads, f"- {today()} — {text} → [[01-Sessions/{today()}|session]]\n")
    return 0


# ------------------------------------------------------------------- recall


def _recent(vault: Path, folder: str, limit: int) -> list[Path]:
    files = sorted(
        (p for p in (vault / folder).glob("*.md")),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    return files[:limit]


def _excerpt(path: Path, lines: int = 40) -> str:
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return ""
    body = text.split("---", 2)[-1] if text.startswith("---") else text
    kept = [ln for ln in body.splitlines() if ln.strip()][:lines]
    return "\n".join(kept)


def build_recall(vault: Path, name: str, query: str | None = None) -> str:
    out = [f"# Brain — {name}", "", f"Vault: `{vault}`", ""]

    threads = vault / "99-Meta" / "Open Threads.md"
    if threads.exists():
        open_lines = [ln for ln in threads.read_text(encoding="utf-8").splitlines()
                      if ln.startswith("- ") and "~~" not in ln][-8:]
        if open_lines:
            out += ["## Open threads", ""] + open_lines + [""]

    sessions = _recent(vault, "01-Sessions", 3)
    if sessions:
        out += ["## Recent sessions", ""]
        for path in sessions:
            out += [f"### {path.stem}", "", _excerpt(path, 30), ""]

    decisions = _recent(vault, "02-Decisions", 8)
    if decisions:
        out += ["## Decisions already made (settled — do not re-litigate)", ""]
        out += [f"- [[02-Decisions/{p.stem}|{p.stem}]]" for p in decisions] + [""]

    knowledge = _recent(vault, "03-Knowledge", 10)
    if knowledge:
        out += ["## Verified knowledge (trust these; they cost something to establish)", ""]
        out += [f"- [[03-Knowledge/{p.stem}|{p.stem}]]" for p in knowledge] + [""]

    if query:
        hits = search_vault(vault, query, limit=10)
        if hits:
            out += [f"## Matching '{query}'", ""] + [f"- {h}" for h in hits] + [""]

    out += [
        "---",
        "Write back as you work: `brain log`, `brain decision`, `brain note`.",
        "The contract is in the vault's `CLAUDE.md`.",
    ]
    return "\n".join(out)


def cmd_recall(args) -> int:
    vault, name = _vault_and_name()
    print(build_recall(vault, name, args.query))
    return 0


def cmd_session_start(args) -> int:
    """SessionStart hook: inject the brain into the fresh session's context.

    Must never fail the session. An unbound project prints one nudging line
    rather than an error, because most directories are not brain-backed and a
    hook that shouts on every unrelated session gets disabled within a day.
    """
    try:
        vault = find_vault()
        if vault is None or not vault.exists():
            return 0
        root = project_root()
        name = registry()["vaults"].get(str(root), {}).get("name", vault.name)
        ensure_session_note(vault, name)
        print(build_recall(vault, name))
    except Exception as exc:  # noqa: BLE001 - a hook must not break the session
        print(f"<!-- brain: recall unavailable ({exc}) -->")
    return 0


def search_vault(vault: Path, query: str, limit: int = 25) -> list[str]:
    pattern = re.compile(re.escape(query), re.IGNORECASE)
    scored: list[tuple[float, str]] = []
    for path in vault.rglob("*.md"):
        if ".obsidian" in path.parts:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        for i, line in enumerate(text.splitlines(), 1):
            if pattern.search(line):
                rel = path.relative_to(vault)
                scored.append((path.stat().st_mtime, f"{rel}:{i}: {line.strip()[:120]}"))
                break
    scored.sort(reverse=True)
    return [s for _, s in scored[:limit]]


def cmd_search(args) -> int:
    vault = require_vault()
    hits = search_vault(vault, args.query, args.limit)
    if not hits:
        print(f"no match for {args.query!r} in {vault}")
        return 1
    for hit in hits:
        print(hit)
    return 0



def _generated(line: str) -> bool:
    """True for a line this tool wrote into a generated block.

    Used only by the one-time migration off unbounded markers. Deliberately
    narrow: a wikilink bullet, the italic empty placeholder, or blank. Anything
    else is someone's prose and is left exactly where it is.
    """
    stripped = line.strip()
    if not stripped:
        return True
    if stripped.startswith("- [["):
        return True
    return stripped.startswith("_(") and stripped.endswith(")_")


def _replace_block(text: str, key: str, lines: list[str]) -> str:
    """Rewrite one generated block, bounded by an explicit closing marker.

    The bounding is the whole point. An earlier version matched from the opening
    marker to the next `## ` heading or the end of the file, which meant anything
    typed below the last block — with no heading after it — was silently deleted
    on the next `brain index`. In a tool whose entire premise is "this file is
    your memory", quietly eating notes is the worst thing it could possibly do.
    """
    opening = f"<!-- brain:{key} -->"
    closing = f"<!-- /brain:{key} -->"
    if opening not in text:
        return text

    body = opening + "\n\n" + "\n".join(lines) + "\n\n" + closing
    start = text.index(opening)

    if closing in text[start:]:
        end = text.index(closing, start) + len(closing)
        return text[:start] + body + text[end:]

    # Migration from an unbounded marker: consume ONLY lines that this tool
    # would have written, and stop at the first one it would not have.
    tail = text[start + len(opening):].split("\n")
    consumed = 0
    for line in tail:
        if line.strip().startswith("## ") or not _generated(line):
            break
        consumed += 1
    remainder = "\n".join(tail[consumed:])
    return text[:start] + body + ("\n" + remainder if remainder else "\n")


def cmd_index(args) -> int:
    """Rebuild the MOC's generated sections, and surface orphan notes.

    An orphan — a note nothing links to — is the failure mode of a vault used as
    memory: it was written, so it feels captured, but nothing will ever lead a
    future session back to it. Listing them is the cheap fix.
    """
    vault, name = _vault_and_name()
    moc = vault / "MOC.md"
    if not moc.exists():
        moc.write_text(MOC_TEMPLATE.format(name=name), encoding="utf-8")

    linked: set[str] = set()
    notes: list[Path] = []
    for path in vault.rglob("*.md"):
        if ".obsidian" in path.parts:
            continue
        notes.append(path)
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        for target in re.findall(r"\[\[([^\]\|]+)", text):
            linked.add(target.split("/")[-1].strip())

    def block(folder: str, limit: int) -> list[str]:
        items = _recent(vault, folder, limit)
        return [f"- [[{folder}/{p.stem}|{p.stem}]]" for p in items] or ["_(none yet)_"]

    orphans = [
        f"- [[{p.relative_to(vault).with_suffix('')}|{p.stem}]]"
        for p in sorted(notes, key=lambda p: p.stat().st_mtime, reverse=True)
        if p.stem not in linked and p.stem not in {"MOC", "CLAUDE"}
    ][:20] or ["_(none — everything is reachable)_"]

    sections = {
        "sessions": block("01-Sessions", 10),
        "decisions": block("02-Decisions", 20),
        "knowledge": block("03-Knowledge", 20),
        "unlinked": orphans,
    }

    text = moc.read_text(encoding="utf-8")
    for key, lines in sections.items():
        text = _replace_block(text, key, lines)
    moc.write_text(text, encoding="utf-8")
    print(f"indexed {len(notes)} notes; {len(orphans)} unlinked")
    return 0


# -------------------------------------------------------------------- graph


def cmd_graph(args) -> int:
    """Build or query the code graph, with its output living inside the vault.

    Obsidian remembers what was *decided*; Graphify derives what the code *is*.
    Keeping the derived graph in `05-Graph/` rather than in a stray
    `graphify-out/` is the whole integration: the report becomes a note like any
    other, so a decision note can link straight to the call path that justified
    it, and a fresh session finds both through the same recall.

    Never hand-edit anything under `05-Graph/` — it is regenerated.
    """
    vault, name = _vault_and_name()
    root = project_root()
    out = vault / "05-Graph"
    graph_json = out / "graph.json"

    binary = _which("graphify")
    if not binary:
        print(
            "graphify is not installed.\n"
            "  uv tool install graphifyy   (or: pipx install graphifyy)\n"
            "  graphify install            registers the /graphify skill",
            file=sys.stderr,
        )
        return 1

    env = {**os.environ, "GRAPHIFY_OUT": str(out)}

    if args.query:
        if not graph_json.exists():
            print(f"no graph yet at {graph_json} — run `brain graph` first", file=sys.stderr)
            return 1
        cmd = [binary, "query", args.query, "--graph", str(graph_json)]
        if args.budget:
            cmd += ["--budget", str(args.budget)]
        proc = subprocess.run(cmd, cwd=root, env=env, capture_output=True, text=True)
        answer = (proc.stdout or proc.stderr).strip()
        print(answer)
        if proc.returncode == 0 and answer:
            add_to_section(
                ensure_session_note(vault, name),
                "Actions",
                f'- **{stamp()}** graph query — "{args.query}"',
            )
        return proc.returncode

    # Build. --code-only keeps it fully local and key-free: AST parsing only,
    # nothing leaves the machine and no LLM credit is spent.
    cmd = [binary, str(root)]
    if args.code_only:
        cmd = [binary, "extract", str(root), "--code-only"]
    if args.update:
        cmd.append("--update")
    out.mkdir(parents=True, exist_ok=True)
    print(f"$ {' '.join(cmd)}   (GRAPHIFY_OUT={out})")
    proc = subprocess.run(cmd, cwd=root, env=env)
    if proc.returncode != 0:
        print("graphify failed — see its output above", file=sys.stderr)
        return proc.returncode

    report = out / "GRAPH_REPORT.md"
    note = out / "Code Graph.md"
    body = [
        "---",
        f"updated: {today()}",
        f"project: {name}",
        "type: graph",
        "tags: [graph, graphify, derived]",
        "---",
        "",
        f"# Code graph — {name}",
        "",
        "**Derived, not written.** Regenerated by `brain graph`; never hand-edit",
        "anything in this folder. Link *to* it from decisions and knowledge notes,",
        "and let those carry the reasoning.",
        "",
        f"- Source: `{root}`",
        f"- Graph: `{graph_json.name}`" + ("" if graph_json.exists() else "  _(not produced)_"),
        "- Visualisation: `graph.html`" if (out / "graph.html").exists() else "",
        f"- Report: [[05-Graph/GRAPH_REPORT|GRAPH_REPORT]]" if report.exists() else "",
        "",
        "## Ask it things",
        "",
        "```bash",
        'brain graph --query "what calls the swing detector?"',
        'graphify path "MotionManager" "SessionModel"',
        "```",
        "",
        "---",
        f"Rebuilt: [[01-Sessions/{today()}|{today()}]]",
        "",
    ]
    note.write_text("\n".join(line for line in body if line != ""), encoding="utf-8")
    add_to_section(
        ensure_session_note(vault, name),
        "Actions",
        f"- **{stamp()}** rebuilt the code graph → [[05-Graph/Code Graph|Code Graph]]",
    )
    print(f"\ngraph written into the vault: {out}")
    return 0



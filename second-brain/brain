def _which(name: str) -> str | None:
    found = shutil.which(name)
    if found:
        return found
    # These install outside PATH in exactly the situation where someone reports
    # "it isn't working", so look where they actually land per platform.
    if IS_WINDOWS:
        extras = [
            Path(os.environ.get("LOCALAPPDATA", HOME)) / "Programs",
            Path(os.environ.get("APPDATA", HOME)) / "npm",
            HOME / ".local" / "bin",
        ]
        suffixes = ["", ".exe", ".cmd", ".bat"]
    else:
        extras = [HOME / ".local" / "bin", Path("/opt/homebrew/bin"), Path("/usr/local/bin")]
        suffixes = [""]

    for extra in extras:
        for suffix in suffixes:
            candidate = extra / (name + suffix)
            if candidate.exists() and os.access(candidate, os.X_OK):
                return str(candidate)
    return None


def _port_open(host: str, port: int, timeout: float = 0.4) -> bool:
    import socket

    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def _version(cmd: list[str]) -> str | None:
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return None
    text = (out.stdout or out.stderr).strip().splitlines()
    return text[0][:60] if text else ""



# Paths that mean a vault lives in a syncing cloud folder. Obsidian officially
# supports iCloud, and the vault working from several machines is the point —
# but the failure mode below is specific and silent, so it is worth naming.
CLOUD_MARKERS = (
    ("iCloud", "Library/Mobile Documents"),
    ("iCloud", "Mobile Documents/com~apple~CloudDocs"),
    ("Dropbox", "Dropbox"),
    ("Google Drive", "Google Drive"),
    ("OneDrive", "OneDrive"),
)


def _cloud_provider(path: Path) -> str | None:
    text = str(path)
    for name, marker in CLOUD_MARKERS:
        if marker in text:
            return name
    return None


def _evicted(vault: Path, limit: int = 2000) -> list[Path]:
    """Notes iCloud has evicted to save space.

    With "Optimize Mac Storage" on, iCloud replaces a file's contents with a
    `.name.md.icloud` placeholder and REMOVES the real name from the directory.
    Nothing errors — a glob for `*.md` simply does not see it. For a vault whose
    whole job is being read at session start, that is silent amnesia: the note
    exists, the recall omits it, and nothing anywhere says so.
    """
    found = []
    for path in vault.rglob(".*.icloud"):
        if ".obsidian" in path.parts:
            continue
        found.append(path)
        if len(found) >= limit:
            break
    return found


def _cloud_row(vault: Path) -> tuple[str, bool, str]:
    provider = _cloud_provider(vault)
    if not provider:
        return ("vault storage", True, "on local disk")

    evicted = _evicted(vault)
    if not evicted:
        return (
            "vault storage",
            True,
            f"{provider}, fully downloaded — keep it that way with "
            f"Finder → right-click the vault → Keep Downloaded",
        )
    names = ", ".join(p.name.lstrip(".").removesuffix(".icloud") for p in evicted[:3])
    more = f" (+{len(evicted) - 3} more)" if len(evicted) > 3 else ""
    return (
        "vault storage",
        False,
        f"{provider}: {len(evicted)} note(s) evicted and INVISIBLE to recall "
        f"— {names}{more}. Fix: right-click the vault in Finder → Keep "
        f"Downloaded, or run `brctl download <vault>`",
    )


def cmd_doctor(args) -> int:
    rows: list[tuple[str, bool, str]] = []

    # --- the memory itself
    vault = find_vault()
    if vault and vault.exists():
        notes = sum(1 for _ in vault.rglob("*.md"))
        rows.append(("vault", True, f"{vault} ({notes} notes)"))
    elif vault:
        rows.append(("vault", False, f"registered but missing: {vault} — re-run `brain init`"))
    else:
        rows.append(("vault", False, "not bound here — run `brain init`"))

    if vault and vault.exists():
        rows.append(_cloud_row(vault))

    app = Path("/Applications/Obsidian.app")
    rows.append(
        ("obsidian app", app.exists(),
         "installed" if app.exists() else "not found — obsidian.md (the vault works without it; "
         "this is only the reader)")
    )

    settings = HOME / ".claude" / "settings.json"
    hooks_ok = False
    if settings.exists():
        hooks_ok = "brain" in settings.read_text(encoding="utf-8", errors="replace")
    rows.append(
        ("claude hooks", hooks_ok,
         "wired in ~/.claude/settings.json" if hooks_ok
         else "not wired — run `second-brain/install.sh` (without hooks, capture is manual)")
    )

    # --- the toolchain
    claude = _which("claude")
    rows.append(("claude code", bool(claude), claude or "not on PATH"))

    graphify = _which("graphify")
    rows.append(
        ("graphify", bool(graphify),
         f"{graphify}  {_version([graphify, '--version']) or ''}" if graphify
         else "not installed — `uv tool install graphifyy` then `graphify install`")
    )

    hermes = _which("hermes")
    if hermes:
        detail = _version([hermes, "version"]) or "installed"
        rows.append(("hermes", True, f"{hermes}  {detail}"))
        rows.append(("hermes health", True, "run `hermes doctor --fix` for its own diagnosis"))
    else:
        rows.append(
            ("hermes", False,
             "not on PATH — installs to ~/.local/bin; try `source ~/.zshrc`, "
             "else `curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash`")
        )

    openclaw = _which("openclaw")
    rows.append(
        ("openclaw", bool(openclaw), openclaw or
         "not installed — `curl -fsSL https://openclaw.ai/install.sh | bash`")
    )

    figma_local = _port_open("127.0.0.1", 3845)
    rows.append(
        ("figma mcp", figma_local,
         "desktop server up on 127.0.0.1:3845" if figma_local
         else "local server down — open Figma desktop → Preferences → Enable Dev Mode MCP "
              "server (or use the remote server, which needs no app running)")
    )

    # MCP registrations are the seam where 'installed' and 'connected' diverge,
    # so read the config rather than trusting the binaries being present.
    mcp_names: set[str] = set()
    for path in (Path.cwd() / ".mcp.json", HOME / ".claude.json", HOME / ".claude" / "settings.json"):
        if path.exists():
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
            except (json.JSONDecodeError, UnicodeDecodeError):
                continue
            mcp_names |= set((data.get("mcpServers") or {}).keys())
            for proj in (data.get("projects") or {}).values():
                if isinstance(proj, dict):
                    mcp_names |= set((proj.get("mcpServers") or {}).keys())
    for label, needle in (("mcp: hermes", "hermes"), ("mcp: n8n", "n8n"),
                          ("mcp: figma", "figma"), ("mcp: canva", "canva")):
        present = any(needle in name.lower() for name in mcp_names)
        rows.append((label, present, "registered" if present else "not registered with Claude Code"))

    width = max(len(label) for label, _, _ in rows)
    failures = 0
    for label, ok, detail in rows:
        mark = "ok  " if ok else "MISS"
        failures += 0 if ok else 1
        print(f"[{mark}] {label:<{width}}  {detail}")
    print()
    print(f"{len(rows) - failures}/{len(rows)} checks passing")
    return 0 if failures == 0 else 1


# --------------------------------------------------------------------- main


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="brain", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("init", help="create or attach a vault for this project")
    p.add_argument("--vault", help="explicit vault path (default ~/Obsidian/<project>)")
    p.add_argument("--name", help="project name (default: directory name)")
    p.set_defaults(func=cmd_init)

    sub.add_parser("where", help="print the vault bound here").set_defaults(func=cmd_where)
    sub.add_parser("list", help="every vault on this machine").set_defaults(func=cmd_list)
    sub.add_parser("session-start", help="emit recall context (SessionStart hook)").set_defaults(
        func=cmd_session_start)
    sub.add_parser("doctor", help="check the whole toolchain").set_defaults(func=cmd_doctor)
    sub.add_parser("index", help="rebuild the map-of-content").set_defaults(func=cmd_index)

    p = sub.add_parser("prompt", help="record a prompt verbatim (UserPromptSubmit hook)")
    p.add_argument("text", nargs="?")
    p.set_defaults(func=cmd_prompt)

    p = sub.add_parser("log", help="append an entry to today's session note")
    p.add_argument("text", nargs="?")
    p.add_argument("--kind", help="short tag, e.g. build, test, fix")
    p.set_defaults(func=cmd_log)

    p = sub.add_parser("decision", help="record a decision as its own note")
    p.add_argument("title")
    p.add_argument("--what", help="what was decided")
    p.add_argument("--why", help="the reasoning")
    p.add_argument("--rejected", help="alternatives and why they lost")
    p.add_argument("--revisit", help="what would make this wrong")
    p.set_defaults(func=cmd_decision)

    p = sub.add_parser("note", help="create or revise a durable knowledge note")
    p.add_argument("title")
    p.add_argument("--body")
    p.add_argument("--folder", default="03-Knowledge", choices=FOLDERS)
    p.add_argument("--tag", action="append")
    p.set_defaults(func=cmd_note)

    p = sub.add_parser("graph", help="build or query the code graph, into the vault")
    p.add_argument("--query", help="ask the graph a question instead of rebuilding")
    p.add_argument("--budget", type=int, help="cap tokens returned by a query")
    p.add_argument("--code-only", action="store_true",
                   help="AST only: fully local, no LLM key needed")
    p.add_argument("--update", action="store_true", help="re-extract only changed files")
    p.set_defaults(func=cmd_graph)

    p = sub.add_parser("tool", help="record a file-changing tool call (PostToolUse hook)")
    p.add_argument("text", nargs="?")
    p.set_defaults(func=cmd_tool)

    p = sub.add_parser("session-end", help="close out today's note (SessionEnd hook)")
    p.add_argument("text", nargs="?")
    p.set_defaults(func=cmd_session_end)

    p = sub.add_parser("recall", help="what a new session should know")
    p.add_argument("query", nargs="?")
    p.set_defaults(func=cmd_recall)

    p = sub.add_parser("search", help="grep the vault, newest first")
    p.add_argument("query")
    p.add_argument("--limit", type=int, default=25)
    p.set_defaults(func=cmd_search)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
